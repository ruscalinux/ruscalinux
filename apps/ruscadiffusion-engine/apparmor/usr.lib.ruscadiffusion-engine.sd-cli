# ------------------------------------------------------------------------
# RuscaLinux — profilo AppArmor per il motore di generazione delle
# immagini (sd-cli).
#
# Consegnato in modalita' COMPLAIN: registra le violazioni nel journal,
# non blocca niente. E' deliberato: un profilo non provato che blocca il
# motore e' peggio di nessun profilo.
#
# Per vedere cosa avrebbe bloccato, dopo qualche sessione d'uso:
#     sudo journalctl -b | grep 'apparmor=.*sd-cli'
#
# Per passare a enforce dopo averlo provato:
#     sudo rm /etc/apparmor.d/force-complain/usr.lib.ruscadiffusion-engine.sd-cli
#     sudo apparmor_parser -r /etc/apparmor.d/usr.lib.ruscadiffusion-engine.sd-cli
# ------------------------------------------------------------------------

abi <abi/4.0>,

include <tunables/global>

profile ruscadiffusion-engine /usr/lib/ruscadiffusion-engine/sd-cli {
  include <abstractions/base>

  # Il motore e' l'unico processo che apre i modelli, cioe' file spesso
  # presi da internet. Puo' leggere i modelli (.safetensors, .sft, .gguf,
  # .ckpt, e il tokenizzatore .json di alcuni)
  # nella home, anche nelle cartelle aggiunte da RuscaLLama, e nelle
  # cartelle dei modelli.
  owner @{HOME}/**/ r,
  owner @{HOME}/**/*.safetensors r,
  owner @{HOME}/**/*.sft r,
  owner @{HOME}/**/tokenizer*.json r,
  owner @{HOME}/**/*.gguf r,
  owner @{HOME}/**/*.ckpt r,
  owner @{HOME}/.local/share/ruscadiffusion/models/ r,
  owner @{HOME}/.local/share/ruscadiffusion/models/** r,
  /usr/share/ruscadiffusion/models/ r,
  /usr/share/ruscadiffusion/models/** r,

  # Cartella di lavoro di RuscaLLama: il prompt (file di testo), le
  # anteprime, le immagini e i video (.avi) generati, l'immagine di
  # partenza di un video (copiata li' da RuscaLLama). E' l'unico posto in cui il motore
  # scrive.
  owner @{HOME}/.cache/ruscallama/images/ r,
  owner @{HOME}/.cache/ruscallama/images/** rw,

  # Dal terminale: immagini scritte in Immagini e video in Video.
  owner @{HOME}/Pictures/** rw,
  owner @{HOME}/Immagini/** rw,
  owner @{HOME}/Videos/** rw,
  owner @{HOME}/Video/** rw,

  # Il proprio binario.
  /usr/lib/ruscadiffusion-engine/sd-cli mr,

  # Rete: nessuna. sd-cli e' compilato senza server e senza RPC (la build
  # controlla che il binario non usi socket) e qui e' negata comunque.
  deny network,

  # Accelerazione grafica: senza queste il backend Vulkan non trova la
  # scheda e ripiega sulla CPU, in silenzio e molto piu' lentamente.
  /dev/dri/ r,
  /dev/dri/** rw,
  /dev/nvidia* rw,
  /dev/nvidiactl rw,
  /dev/nvidia-uvm* rw,
  /sys/devices/** r,
  /sys/class/drm/ r,
  /sys/class/drm/** r,
  /etc/vulkan/** r,
  /usr/share/vulkan/** r,
  /usr/share/libdrm/** r,
  owner @{HOME}/.cache/mesa_shader_cache/** rwk,
  owner @{HOME}/.cache/mesa_shader_cache_db/** rwk,
  owner @{HOME}/.cache/nvidia/** rwk,
  owner @{HOME}/.nv/** rwk,
  include if exists <abstractions/vulkan>
  include if exists <abstractions/mesa>

  # Informazioni sulla macchina, usate per decidere quanti thread usare e
  # quanta memoria c'e'.
  @{PROC}/cpuinfo r,
  @{PROC}/meminfo r,
  @{PROC}/sys/kernel/mm/transparent_hugepage/* r,
  owner @{PROC}/@{pid}/** r,
  /sys/devices/system/cpu/** r,

  # Niente di tutto questo serve al motore, e sono le cose che un modello
  # malevolo cercherebbe per prime. Un modello tenuto in queste cartelle
  # non e' leggibile quando il profilo e' in enforce.
  deny @{HOME}/.ssh/** rwx,
  deny @{HOME}/.gnupg/** rwx,
  deny @{HOME}/.mozilla/** rwx,
  deny @{HOME}/.thunderbird/** rwx,
  deny @{HOME}/.config/** rwx,
  deny /etc/shadow r,

  include if exists <local/ruscadiffusion-engine>
}
