# ------------------------------------------------------------------------
# RuscaLinux — profilo AppArmor per il motore di riconoscimento vocale
# (whisper-cli).
#
# Consegnato in modalita' COMPLAIN: registra le violazioni nel journal,
# non blocca niente. E' deliberato: un profilo non provato che blocca il
# motore e' peggio di nessun profilo.
#
# Per vedere cosa avrebbe bloccato, dopo qualche sessione d'uso:
#     sudo journalctl -b | grep 'apparmor=.*whisper-cli'
#
# Per passare a enforce dopo averlo provato:
#     sudo rm /etc/apparmor.d/force-complain/usr.lib.ruscawhisper-engine.whisper-cli
#     sudo apparmor_parser -r /etc/apparmor.d/usr.lib.ruscawhisper-engine.whisper-cli
# ------------------------------------------------------------------------

abi <abi/4.0>,

include <tunables/global>

profile ruscawhisper-engine /usr/lib/ruscawhisper-engine/whisper-cli {
  include <abstractions/base>

  # Il motore e' l'unico processo che apre i modelli, cioe' file spesso
  # presi da internet. Puo' leggere i modelli ggml (.bin) nella home e
  # nelle cartelle dei modelli.
  owner @{HOME}/**/*.bin r,
  owner @{HOME}/.local/share/ruscawhisper/models/ r,
  owner @{HOME}/.local/share/ruscawhisper/models/** r,
  /usr/share/ruscawhisper/models/ r,
  /usr/share/ruscawhisper/models/** r,

  # Cartella di lavoro di RuscaDubbing: l'audio da trascrivere (WAV
  # preparato da FFmpeg) e il risultato in JSON. E' l'unico posto in cui
  # il motore scrive.
  owner @{HOME}/.cache/ruscadubbing/ r,
  owner @{HOME}/.cache/ruscadubbing/** rw,

  # Dal terminale: audio che whisper-cli sa leggere da solo.
  owner @{HOME}/**/*.wav r,
  owner @{HOME}/**/*.mp3 r,
  owner @{HOME}/**/*.flac r,
  owner @{HOME}/**/*.ogg r,

  # I propri binari e le proprie librerie.
  /usr/lib/ruscawhisper-engine/whisper-cli mr,
  /usr/lib/ruscawhisper-engine/*.so* mr,

  # Rete: nessuna. whisper-cli non ha codice di rete (la build controlla
  # che i binari non usino socket) e qui e' negata comunque.
  deny network,

  # Accelerazione grafica: senza queste il backend Vulkan non trova la
  # scheda e ripiega sulla CPU, in silenzio e molto piu' lentamente.
  /dev/dri/ r,
  /dev/dri/** rw,
  /dev/nvidia* rw,
  /dev/nvidiactl rw,
  /dev/nvidia-uvm* rw,
  /sys/devices/** r,
  /sys/class/drm/ r,
  /sys/class/drm/** r,
  /etc/vulkan/** r,
  /usr/share/vulkan/** r,
  /usr/share/libdrm/** r,
  include if exists <abstractions/vulkan>
  include if exists <abstractions/mesa>

  # Informazioni sulla macchina, usate per decidere quanti thread usare.
  @{PROC}/cpuinfo r,
  @{PROC}/meminfo r,
  @{PROC}/sys/kernel/mm/transparent_hugepage/* r,
  owner @{PROC}/@{pid}/** r,
  /sys/devices/system/cpu/** r,

  # Niente di tutto questo serve al motore, e sono le cose che un modello
  # malevolo cercherebbe per prime. Un modello tenuto in queste cartelle
  # non e' leggibile quando il profilo e' in enforce.
  deny @{HOME}/.ssh/** rwx,
  deny @{HOME}/.gnupg/** rwx,
  deny @{HOME}/.mozilla/** rwx,
  deny @{HOME}/.thunderbird/** rwx,
  deny @{HOME}/.config/** rwx,
  deny /etc/shadow r,

  include if exists <local/ruscawhisper-engine>
}
